#!/bin/sh
# pre-push: scan the commits being pushed for secrets, at the last point where history is still
# cheap to rewrite (org guide: "Never commit secrets").
#
# TOOLCHAIN (ywr-harness ADR 0010, ywr-harness ADR 0015): placed by /ywr-harness:harness-init and
# overwritten on every re-run. Do not hand-edit it. Fix it in the canon and re-run the scaffold.
#
# Scope, and why each bound is here:
#   * ADDED lines only. A secret already in history is a rotation problem, not a push to block, and
#     flagging it on every push trains people to use --no-verify.
#   * Only commits not already on a remote. Pushing a new branch must not re-scan all of history.
#   * A line carrying the marker `harness:allow-secret` is exempt. Regex scanning is wrong sometimes,
#     and the alternative to a per-line exemption is --no-verify on the entire push.
#
# git feeds this hook on stdin, one line per ref:  <local ref> <local oid> <remote ref> <remote oid>
#
# Failure is a blocked push. `git push --no-verify` is the escape hatch; a rejected push means the
# secret is still local, which is the entire point.
#
# Copyright (c) 2026 YWR Labs Inc. All rights reserved.

# No pattern may match this file's own source: a hook that flags its own addition cannot be installed.
# The ywr-harness selftest asserts that property.
#
# Each entry: <label>|<extended regex>
PATTERNS='aws-access-key-id|AKIA[0-9A-Z]{16}
private-key-block|-----BEGIN [A-Z ]*PRIVATE KEY-----
github-token|gh[pousr]_[A-Za-z0-9]{36}
github-fine-grained-pat|github_pat_[A-Za-z0-9_]{22,}
anthropic-api-key|sk-ant-[A-Za-z0-9_-]{24,}
openai-api-key|sk-proj-[A-Za-z0-9_-]{24,}
slack-token|xox[baprs]-[A-Za-z0-9-]{10,}
google-api-key|AIza[A-Za-z0-9_-]{35}
stripe-secret-key|sk_live_[A-Za-z0-9]{16,}
npm-token|npm_[A-Za-z0-9]{36}
generic-assigned-secret|(secret|token|passwd|password|api_?key|access_?key)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"'[:space:]]{12,}["'"'"']'

# --- resolve the commit set ---------------------------------------------------------------------
# A commit list that git failed to produce is never an empty set, because an empty set passes the push
# unread. A non-zero exit blocks. An empty list with exit 0 is a quiet pass.
unresolved() {
    echo "[harness] pre-push BLOCKED — the commit set for $1 could not be resolved (git rev-list failed),"
    echo "[harness]   so no commit of it was scanned for secrets."
    echo "[harness] Fetch the remote and push again. \`git push --no-verify\` skips this scan; the CI backstop"
    echo "[harness]   scans the same commits."
    exit 1
}

COMMITS=''
# `read` returns non-zero on a last line that has no newline, with the fields already set. The second
# test keeps that line: dropping it would pass its ref unread.
while read -r _local_ref local_oid _remote_ref remote_oid || [ -n "$_local_ref" ]; do
    # Strip CR. A wrapper or a Windows tool that hands this hook CRLF would leave \r in the trailing
    # field, and `git rev-list <sha>\r..<sha>` matches nothing, so a clean report would follow an
    # empty scan.
    local_oid=$(printf '%s' "$local_oid" | tr -d '\r')
    remote_oid=$(printf '%s' "$remote_oid" | tr -d '\r')
    [ -n "$local_oid" ] || continue
    # All-zero local oid = branch deletion. Nothing is being added, so nothing to scan.
    case "$local_oid" in *[!0]*) ;; *) continue ;; esac

    case "$remote_oid" in
        *[!0]*)
            # Existing remote branch: exactly what this push adds. A failed rev-list is not an empty one.
            # When the remote oid is no local object (a force-push over commits never fetched), the list
            # fails, and reading that as "nothing to scan" would pass the push unread. Fall back to the
            # wider set that a new branch gets, and say so.
            if ! found=$(git rev-list "$remote_oid..$local_oid" 2>/dev/null); then
                echo "[harness] pre-push: $remote_oid is not a local object, so the range for $_local_ref is unknown;"
                echo "[harness]   scanning every commit of it that is not on a remote instead."
                found=$(git rev-list "$local_oid" --not --remotes 2>/dev/null) || unresolved "$_local_ref"
                # An empty wider list is a pass, and it must read as one: no commit was scanned.
                [ -n "$found" ] || echo "[harness] pre-push: every commit of $_local_ref is already on a remote, so 0 commits of it were scanned."
            fi
            ;;
        *)
            # New branch: everything not already reachable from some remote-tracking ref. Without
            # `--not --remotes` this is the whole history of the branch on its first push.
            found=$(git rev-list "$local_oid" --not --remotes 2>/dev/null) || unresolved "$_local_ref"
            ;;
    esac
    [ -n "$found" ] && COMMITS="$COMMITS$found
"
done

COMMITS=$(printf '%s' "$COMMITS" | sed '/^$/d' | sort -u)
[ -n "$COMMITS" ] || exit 0

N_COMMITS=$(printf '%s\n' "$COMMITS" | sed '/^$/d' | wc -l | tr -d ' ')

report_clean() {
    echo "[harness] pre-push: no secret pattern in added lines ($N_COMMITS commit(s) scanned)."
    exit 0
}

# --- scan added lines ----------------------------------------------------------------------------
# `git show -U0 --format=` prints the diff alone. A merge commit prints nothing by default, which is
# correct: a merge introduces no new content of its own.
#
# The file header of a diff is `+++ b/<path>`, `+++ "b/<path>"` for a quoted path, or `+++ /dev/null`.
# An added line whose text starts with `++` also prints as `+++`, so a filter on `^+++` alone drops that
# line unread. The filters drop only the three header forms, and `/dev/null` only as the whole line.
# The prefixes are fixed on the command line, because the diff.noprefix and diff.mnemonicPrefix
# settings change them.
#
# The scan runs in the C locale, and every grep in it takes `-a`. Under a UTF-8 locale (every Linux
# CI runner) GNU grep treats a line that is not valid UTF-8 as binary and drops it from its output.
# Such a line never reaches the pattern loop, and the commit still counts as scanned. In the C locale
# every byte is a character, so no line is an encoding error and `[^...]` classes match non-ASCII bytes
# too. `-a` covers the remaining binary trigger, a NUL byte in a diff that git prints as text.
LC_ALL=C
export LC_ALL
HITS=''
OLD_IFS=$IFS
IFS='
'

# Prefilter: one git process prints every commit's -U0 diff and one grep reads all of it. The loop
# below starts about fourteen processes per commit, which is slow on Windows.
# The prefilter only ever answers "clean", and only with proof that it read every commit: the header
# lines must number $N_COMMITS, and git's own exit status must reach the stream as `harness-status 0`.
# The count alone is not enough, because a stream cut inside the last commit's diff still has every header.
# A git that failed or lacks an option fails one of the two, so the loop runs instead. A match falls
# through to the loop too, which builds the labelled report. Neither marker line has a leading `+`, so
# no added line can forge one. The status is taken from the git command itself, directly before the
# filters, because sh has no pipefail and a filter's status says nothing about git. The stream goes to
# a file in the git dir because a large push does not fit a shell variable.
PF=''
GD=$(git rev-parse --git-dir 2>/dev/null) && PF="$GD/harness-pre-push.$$"
trap 'rm -f "$PF"' EXIT
trap 'rm -f "$PF"; exit 1' HUP INT TERM
if [ -n "$PF" ]; then
    { printf '%s\n' "$COMMITS" | git show --stdin --no-walk --format='harness-commit %H' -U0 --no-color --cc --src-prefix=a/ --dst-prefix=b/; echo "harness-status $?"; } 2>/dev/null |
        grep -a -e '^harness-commit ' -e '^harness-status ' -e '^+' 2>/dev/null |
        grep -av -e '^+++ b/' -e '^+++ "b/' -e '^+++ /dev/null$' -e 'harness:allow-secret' > "$PF" 2>/dev/null
    if [ "$(grep -a -c '^harness-commit ' "$PF" 2>/dev/null)" = "$N_COMMITS" ] &&
        [ "$(grep -a -c '^harness-status 0$' "$PF" 2>/dev/null)" = 1 ]; then
        # Every pattern as its own `-e`, for the reason the loop gives. This hook's own arguments are
        # unused from here on, so the pattern list can ride in the positional parameters.
        set --
        for entry in $PATTERNS; do set -- "$@" -e "${entry#*|}"; done
        grep -a -E -q "$@" "$PF" 2>/dev/null
        # 1 is "no line matched". 0 is a match and 2 or more is a grep that did not run. Both go to the loop.
        [ $? -eq 1 ] && report_clean
    fi
    rm -f "$PF"
fi
# A commit whose diff git could not print was not scanned, so it blocks the push like a failed commit
# list does. An empty diff is no proof: a missing blob prints nothing and exits 128. git's exit status
# reaches the filter as the last line, `harness-status N`, which no added line can forge, because
# every added line starts with `+`.
UNREAD=''
for sha in $COMMITS; do
    [ -n "$sha" ] || continue
    added=$({ git show --format= -U0 --no-color --src-prefix=a/ --dst-prefix=b/ "$sha" 2>/dev/null; echo "harness-status $?"; } |
        grep -a -e '^+' -e '^harness-status ' | grep -av -e '^+++ b/' -e '^+++ "b/' -e '^+++ /dev/null$')
    case "$added" in
        'harness-status 0'|*'
harness-status 0') ;;
        *) UNREAD="$UNREAD  $sha
"; continue ;;
    esac
    added=$(printf '%s\n' "$added" | grep -av '^harness-status ')
    [ -n "$added" ] || continue
    # Exempt lines carrying the marker BEFORE matching, so an allowed line cannot trip a pattern.
    added=$(printf '%s\n' "$added" | grep -av 'harness:allow-secret')
    [ -n "$added" ] || continue
    for entry in $PATTERNS; do
        label=${entry%%|*}
        rx=${entry#*|}
        # `-e` is required. The `private-key-block` regex begins with `-----`, so without `-e` grep
        # parses it as an option bundle, prints "unknown option" and returns nothing. The pattern is
        # then skipped while the hook still reports a clean scan.
        hit=$(printf '%s\n' "$added" | grep -a -E -m 3 -e "$rx")
        if [ -n "$hit" ]; then
            short=$(git rev-parse --short "$sha" 2>/dev/null)
            HITS="$HITS  [$label] in $short
$(printf '%s\n' "$hit" | sed 's/^/      /' | cut -c1-160)
"
        fi
    done
done
IFS=$OLD_IFS

if [ -n "$HITS" ]; then
    echo "[harness] pre-push BLOCKED — possible secret in added lines across $N_COMMITS commit(s):"
    printf '%s' "$HITS"
    echo "[harness]"
    # Each commit's own diff is scanned, so only the commit that ADDS a line can exempt it. A later
    # commit carrying the marker clears nothing. The message below names rebase as well as amend,
    # because amend reaches only a hit in the tip commit.
    echo "[harness] If a hit is a false positive, append the marker  harness:allow-secret  to that line"
    echo "[harness]   in the commit that adds it: amend if that commit is the tip, rebase to edit it if"
    echo "[harness]   it is earlier. A later commit cannot clear it — each commit's own diff is scanned."
    echo "[harness] Push with --no-verify only if you have checked every hit; the CI backstop scans the"
    echo "[harness]   same commits and fails that run on the same hit."
    echo "[harness] A test that writes a secret-shaped literal on purpose: put the marker on that line"
    echo "[harness]   when you write it, and the push is never blocked."
    echo "[harness] If it is real: the secret has NOT left this machine. Rewrite the commit AND rotate"
    echo "[harness]   the credential — a rewritten local commit does not un-leak a key you already used."
fi
if [ -n "$UNREAD" ]; then
    echo "[harness] pre-push BLOCKED — git could not print the diff of these commits (git show failed),"
    echo "[harness]   so they were not scanned for secrets:"
    printf '%s' "$UNREAD"
    echo "[harness] Repair the repository (\`git fsck\` names the damage; a partial clone needs its remote), then push."
    echo "[harness]   \`git push --no-verify\` skips this scan; the CI backstop scans the same commits."
fi
[ -z "$HITS" ] && [ -z "$UNREAD" ] || exit 1

report_clean
