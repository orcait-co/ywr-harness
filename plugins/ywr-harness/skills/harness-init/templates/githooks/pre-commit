#!/bin/sh
# pre-commit: run the harness's deterministic gates on the staged files, before any LLM review.
#
# TOOLCHAIN (ywr-harness ADR 0010/0015): placed by /ywr-harness:harness-init and overwritten on
# every re-run. Do not hand-edit it. Fix it in the ywr-harness canon and re-run the scaffold.
#
# It asks scripts/harness/harness_gates.mjs which gates the staged files earn, then runs them. The
# emitter only prints. This hook turns the printing into enforcement.
#
# It deliberately does not:
#
#   * Run whole-program gates (pytest, tsc, vitest, cargo-test, go-vet). It skips and reports them.
#     A hook that runs the test suite is a hook people turn off, and CI
#     (.github/workflows/harness-gates.yml) runs them on the committed content.
#   * Gate staged content. It gates the staged file LIST but runs the commands against the WORKING
#     TREE, because gating staged content means stashing unstaged changes, and a hook that stashes
#     can lose work (ywr-harness ADR 0015). Where the two differ, the CI run is the authority.
#
# Failure blocks the commit. `git commit --no-verify` is the documented escape hatch. A missing
# interpreter is a reported skip, never a silent pass.
#
# Copyright (c) 2026 YWR Labs Inc. All rights reserved.

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# Refuse a staged `enabledPlugins` key (ywr-harness ADR 0022). A committed `enabledPlugins` enables
# the plugin for everyone who clones this repo, which ywr-harness ADR 0010/0012 keep out of the
# managed-settings payload. Both scopes that write into the tree are covered: `--scope project`
# writes .claude/settings.json and `--scope local` writes .claude/settings.local.json.
#
# The key is refused whatever its value. `enabledPlugins` is host install state and does not belong
# in a shared settings file even when empty: an uninstall leaves `{ "enabledPlugins": {} }` behind,
# and every member's install rewrites it. The file stays legitimate. Only the key does not.
#
# Three deliberate properties:
#   * It reads STAGED content, not the working tree. What lands in the commit is the question.
#   * It runs BEFORE the emitter and interpreter checks below, so a repo with no harness scripts and
#     no node on PATH is still protected. The environment must not be able to skip this gate.
#   * It is a literal match, so it cannot see a `\uXXXX`-escaped spelling of the key, which is valid
#     JSON that the host still honors. CI parses the file and catches that. This hook is the floor,
#     CI is the authority (ywr-harness ADR 0015).
#
# `grep -Fqx -e`: -F literal (the paths carry regex metacharacters), -x whole line, -e so that a
# path starting with a dash is never read as an option.
# `--diff-filter=AM` only: without -M/-C git reports no R or C, so listing them would claim rename
# handling that this check does not do.
for _cfg in .claude/settings.json .claude/settings.local.json; do
    git diff --cached --name-only --diff-filter=AM 2>/dev/null | grep -Fqx -e "$_cfg" || continue
    if git show ":$_cfg" 2>/dev/null | grep -q '"enabledPlugins"'; then
        echo "[harness] pre-commit REFUSED: $_cfg declares enabledPlugins."
        echo "[harness]   Committing it forces the plugin on everyone who clones this repo, with no"
        echo "[harness]   choice and no 'plugin disable' that survives the next pull (ywr-harness ADR 0010/0022)."
        echo "[harness]   Both --scope project and --scope local write this key INTO the tree, so"
        echo "[harness]   reinstalling at another scope is not a fix."
        echo "[harness]   Fix: git restore --staged $_cfg and keep it out of git, or uninstall the"
        echo "[harness]   plugin and leave installation to each member. An uninstall can leave an"
        echo "[harness]   empty \"enabledPlugins\": {} behind — remove the key, not just the entry."
        exit 1
    fi
done

EMITTER="$ROOT/scripts/harness/harness_gates.mjs"

if [ ! -f "$EMITTER" ]; then
    echo "[harness] SKIP pre-commit gates — scripts/harness/harness_gates.mjs not found."
    echo "[harness]   Run /ywr-harness:harness-init to place it (reported, not silent)."
    exit 0
fi

# `-c core.quotepath=false`: the emitter takes the list as explicit files, verbatim. Unpinned, a
# clone with core.quotepath=true (the Git for Windows default) lists a non-ASCII path quoted and
# octal-escaped, such as `"docs/\355\225\234...md"`. That path matches no group, and this hook
# would print a false "matched NO declared group" line for a file that CI groups correctly
# (ywr-harness ADR 0077). The pin fixes group matching only. A non-ASCII name still fails the
# emitter's SAFE_TOKEN gate, so it is reported as excluded from file-scoped gate arguments, here
# as in CI. Git still C-quotes a path that holds `"`, `\` or a control character under this pin.
# Only a NUL-separated list carries those, and this newline-delimited list cannot.
STAGED=$(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR)
[ -n "$STAGED" ] || exit 0

# The harness scripts need Node 22 or later (ywr-harness ADR 0220). This hook does not check the
# version. An older node runs the gates on an untested runtime, and only CI, which installs Node 22,
# holds the floor.
NODE=$(command -v node 2>/dev/null)
if [ -z "$NODE" ]; then
    echo "[harness] SKIP pre-commit gates — no node on PATH (reported, not silent). CI still gates this commit."
    exit 0
fi

# awk parses the emitter's output below. A missing awk would yield an empty command list, which
# this hook would report as "no gate matched": a silent false pass.
if ! command -v awk >/dev/null 2>&1; then
    echo "[harness] SKIP pre-commit gates — no awk on PATH, so the emitter's output cannot be parsed"
    echo "[harness]   (reported, not silent — an unparsed emitter would look like 'no gates matched'). CI still gates this commit."
    exit 0
fi

# The emitter takes explicit files, which scopes the run to the staged files, not the tree. The list
# is NUL-delimited through `xargs -0` (portable, unlike the GNU-only `xargs -d`) so a path with
# spaces survives. Warnings go to stderr and show. Only stdout is parsed.
OUT=$(printf '%s\n' "$STAGED" | tr '\n' '\0' | xargs -0 "$NODE" "$EMITTER" --repo "$ROOT")
EMIT_RC=$?
if [ $EMIT_RC -ne 0 ]; then
    echo "[harness] pre-commit: the gate emitter failed (exit $EMIT_RC) — not blocking the commit, but NO GATE RAN."
    exit 0
fi

# Gate command lines are indented exactly four spaces under `gates:`. Two kinds are excluded:
#   ( ... )          the "(no gate declared for this group)" note, which is no command. Running it
#                    would be a shell syntax error blamed on the hook.
#   # whole-program  the emitter's marker for unscoped gates, which CI runs (see the header).
CMDS=$(printf '%s\n' "$OUT" | awk '
    /^gates:/         { g = 1; next }
    /^ungrouped \(/   { g = 0 }
    /^review tier:/   { g = 0 }
    g && /^    [^ (]/ {
        if ($0 ~ /# whole-program/) { next }
        sub(/[ \t]*#.*$/, "")
        sub(/^[ \t]+/, "")
        if (length($0)) print
    }
')
# `grep -c` prints a count and exits 1 when the count is zero, so a `|| echo 0` fallback would add a
# second line and make the variable non-numeric. The exit status stays unused.
DEFERRED=$(printf '%s\n' "$OUT" | grep -c '# whole-program')
[ -n "$DEFERRED" ] || DEFERRED=0
STAGED_N=$(printf '%s\n' "$STAGED" | wc -l | tr -d ' ')

# Group headers are `  [name] N file(s)` (2-space indent) inside the window CMDS reads. The
# no-commands report below uses them to tell declared coverage from a coverage hole: files in a
# group that declares `gates: []` need other words than files that no group claims. The
# scaffold-claimed section cannot match: its column-0 header closes the window first.
MATCHED_GROUPS=$(printf '%s\n' "$OUT" | awk '
    /^gates:/              { g = 1; next }
    /^scaffold-claimed \(/ { g = 0 }
    /^ungrouped \(/        { g = 0 }
    /^review tier:/        { g = 0 }
    # The declared-artifact drift-check header (ywr-harness ADR 0068) shares the 2-space "[label]"
    # shape but is NOT a group that matched staged files. Its trailer is not "] N file(s)", so the
    # strip below would keep the raw tail and garble this report.
    g && /^  \[artifacts\] [0-9]+ declared drift check/ { next }
    g && /^  \[/ {
        line = $0
        # Strip the fixed trailer, not everything after the FIRST "]" — a group name may itself
        # carry "]" and truncating it misnames the group in the report.
        sub(/^  \[/, "", line); sub(/\] [0-9]+ file\(s\)$/, "", line)
        out = out (out == "" ? "" : ", ") line
    }
    END { print out }
')

# The emitter reports files that no group claims, but only CI blocks on them, so a local run would
# read as passing until the first CI run (ywr-harness ADR 0062). This hook says so and never blocks:
# a commit may add a file before the declaration catches up, and the emitter's exit contract stays
# advisory (ywr-harness ADR 0041).
UNGROUPED_N=$(printf '%s\n' "$OUT" | sed -n 's/^ungrouped (\([0-9][0-9]*\) file.*/\1/p' | head -n 1)
if [ -n "$UNGROUPED_N" ]; then
    echo "[harness] pre-commit: $UNGROUPED_N staged file(s) matched NO declared group — CI's harness-gates run FAILS on ungrouped files (not blocked here; add a groups entry to .harness.json)."
fi

if [ -z "$CMDS" ]; then
    if [ -n "$MATCHED_GROUPS" ]; then
        echo "[harness] pre-commit: the $STAGED_N staged file(s) matched group(s) [$MATCHED_GROUPS], but none yields a runnable file-scoped gate here."
    else
        echo "[harness] pre-commit: no file-scoped gate matched the $STAGED_N staged file(s)."
    fi
    if [ "$DEFERRED" -gt 0 ]; then
        echo "[harness]   $DEFERRED whole-program gate(s) deferred to CI (reported, not silent)."
    fi
    exit 0
fi

echo "[harness] pre-commit gates on $STAGED_N staged file(s):"

# Newline-delimited iteration. `set -f` disables globbing for the loop: a gate command that carries
# a `*` would otherwise expand against the hook's working directory before it runs.
#
# Runner preflight (ywr-harness ADR 0015): a missing interpreter is a reported skip, never a silent
# pass. The runner is derived as CI's extraction does it (harness-gates.yml `cmds` step): the first
# token, or the 4th when a `groups[].cwd` prefixed the command as `cd <dir> && ...`. `cd` is a
# builtin that `command -v` accepts, so reading the first token would pass every cwd gate through
# to a 127. A runner missing here is a counted SKIP, never FAILED: a hard failure would block every
# commit of a member without the runner, leaving --no-verify (which also skips the enabledPlugins
# refusal above) as the only way out. CI preflights the same runners and fails by name. A runner
# that exists and fails still blocks.
FAILED=0
RAN=0
SKIPPED=0
OLD_IFS=$IFS
set -f
IFS='
'
for c in $CMDS; do
    [ -n "$c" ] || continue
    IFS=' 	'
    set -- $c
    IFS='
'
    r=$1
    if [ "$1" = "cd" ] && [ "$3" = "&&" ]; then r=$4; fi
    if ! command -v "$r" >/dev/null 2>&1; then
        echo "[harness]   SKIP (runner '$r' not on PATH — reported, not silent; CI still gates this commit): $c"
        SKIPPED=$((SKIPPED + 1))
        continue
    fi
    echo "[harness]   \$ $c"
    ( cd "$ROOT" && sh -c "$c" )
    rc=$?
    RAN=$((RAN + 1))
    if [ $rc -ne 0 ]; then
        echo "[harness]   FAIL ($rc): $c"
        FAILED=1
    fi
done
IFS=$OLD_IFS
set +f

if [ "$DEFERRED" -gt 0 ]; then
    echo "[harness]   $DEFERRED whole-program gate(s) NOT run here — deferred to CI (reported, not silent)."
fi
if [ "$SKIPPED" -gt 0 ]; then
    echo "[harness]   $SKIPPED gate(s) SKIPPED — runner not on PATH here (reported, not silent); CI still gates this commit."
fi

if [ $FAILED -ne 0 ]; then
    echo "[harness] pre-commit: deterministic gates FAILED. Fix them, or commit with --no-verify if"
    echo "[harness]   you have a reason CI will accept."
    exit 1
fi

if [ "$SKIPPED" -gt 0 ]; then
    echo "[harness] pre-commit: $RAN gate(s) passed, $SKIPPED SKIPPED (runner not on PATH) — skipped is not passed; CI still gates this commit."
    exit 0
fi

echo "[harness] pre-commit: deterministic gates passed."
exit 0
