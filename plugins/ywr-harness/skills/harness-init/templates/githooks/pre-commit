#!/bin/sh
# pre-commit — run the harness's deterministic gates on the staged files, before any LLM review
# sees them (org guide: "mechanical defects stay out of the LLM pipeline").
#
# TOOLCHAIN (ywr-harness ADR 0010/0015): placed by /ywr-harness:harness-init and OVERWRITTEN on
# every re-run. Do not hand-edit — fix it in the canon and re-run the scaffold.
#
# What it does: asks scripts/harness/harness_gates.py which gates the staged files earn, then runs
# them. The emitter only prints; this is where the printing turns into enforcement.
#
# WHAT IT DELIBERATELY DOES NOT DO:
#
#   * Whole-program gates (pytest, tsc, vitest, cargo-test, go-vet) are SKIPPED and reported. A
#     pre-commit hook that runs the test suite is a pre-commit hook people turn off, and CI
#     (.github/workflows/harness-gates.yml) already runs them on the committed content.
#   * It gates the staged file LIST but runs the commands against the WORKING TREE. Gating staged
#     *content* would mean stashing unstaged changes, and a hook that stashes is a hook that can
#     lose work (ADR 0015). If those differ for you, the CI run is the authority.
#
# Failure is a blocked commit. `git commit --no-verify` is the documented escape hatch; a missing
# interpreter is a REPORTED skip, never a silent pass.
#
# Copyright (c) 2026 YWR Labs Inc. All rights reserved.

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# ADR 0022 (supersedes 0021) — a committed `enabledPlugins` enables the plugin for everyone who
# clones this repo, and that forcing is exactly what ADR 0010/0012 kept out of the managed-settings
# payload. BOTH scopes that write into the tree are covered: `--scope project` writes
# .claude/settings.json and `--scope local` writes .claude/settings.local.json. ADR 0021 gated only
# the first and its refusal message recommended the second — measured, not assumed.
#
# The KEY is refused regardless of its value. `enabledPlugins` is host install state and does not
# belong in a shared settings file even when empty: an uninstall leaves `{ "enabledPlugins": {} }`
# behind, and every member's install rewrites it. The FILE stays legitimate; only the key does not.
#
# Three deliberate properties:
#   * It reads STAGED content, not the working tree. What lands in the commit is the whole question.
#   * It runs BEFORE the emitter and interpreter checks below, so a repo with no harness scripts and
#     no python on PATH is still protected. This gate must not be skippable by environment.
#   * That is also its limit: a literal match cannot see a `\uXXXX`-escaped spelling of the key,
#     which is valid JSON the host still honors. CI parses the file and catches that; this hook is
#     the floor, not the authority (same split as ADR 0015).
#
# `grep -Fqx -e` : -F literal (the paths carry regex metacharacters), -x whole line, -e because a
# value in command position must never be read as an option (the leading-dash defect, case I2).
# --diff-filter=AM only: without -M/-C git reports no R or C, so listing them read as rename
# handling this check does not do.
for _cfg in .claude/settings.json .claude/settings.local.json; do
    git diff --cached --name-only --diff-filter=AM 2>/dev/null | grep -Fqx -e "$_cfg" || continue
    if git show ":$_cfg" 2>/dev/null | grep -q '"enabledPlugins"'; then
        echo "[harness] pre-commit REFUSED: $_cfg declares enabledPlugins."
        echo "[harness]   Committing it forces the plugin on everyone who clones this repo, with no"
        echo "[harness]   choice and no 'plugin disable' that survives the next pull (ADR 0010/0022)."
        echo "[harness]   Both --scope project and --scope local write this key INTO the tree, so"
        echo "[harness]   reinstalling at another scope is not a fix."
        echo "[harness]   Fix: git restore --staged $_cfg and keep it out of git, or uninstall the"
        echo "[harness]   plugin and leave installation to each member. An uninstall can leave an"
        echo "[harness]   empty \"enabledPlugins\": {} behind — remove the key, not just the entry."
        exit 1
    fi
done

EMITTER="$ROOT/scripts/harness/harness_gates.py"

if [ ! -f "$EMITTER" ]; then
    echo "[harness] SKIP pre-commit gates — scripts/harness/harness_gates.py not found."
    echo "[harness]   Run /ywr-harness:harness-init to place it (reported, not silent)."
    exit 0
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$STAGED" ] || exit 0

PY=$(command -v python 2>/dev/null || command -v python3 2>/dev/null || command -v py 2>/dev/null)
if [ -z "$PY" ]; then
    echo "[harness] SKIP pre-commit gates — no python on PATH (reported, not silent). CI still gates this commit."
    exit 0
fi

# awk parses the emitter's output below. Without this check a missing awk yields an EMPTY command
# list, which this hook would otherwise report as "no gate matched" — a silent false pass, and the
# hardest kind of gate failure to notice because it looks exactly like success.
if ! command -v awk >/dev/null 2>&1; then
    echo "[harness] SKIP pre-commit gates — no awk on PATH, so the emitter's output cannot be parsed"
    echo "[harness]   (reported, not silent — an unparsed emitter would look like 'no gates matched'). CI still gates this commit."
    exit 0
fi

# The emitter takes explicit files, which is what keeps this scoped to the slice rather than the
# tree. NUL-delimited via `xargs -0` (portable; `xargs -d` is GNU-only) so a path with spaces
# survives. Its warnings go to stderr and are shown; only stdout is parsed.
OUT=$(printf '%s\n' "$STAGED" | tr '\n' '\0' | xargs -0 "$PY" "$EMITTER" --repo "$ROOT")
EMIT_RC=$?
if [ $EMIT_RC -ne 0 ]; then
    echo "[harness] pre-commit: the gate emitter failed (exit $EMIT_RC) — not blocking the commit, but NO GATE RAN."
    exit 0
fi

# Gate command lines are indented exactly four spaces under `gates:`. Two things are excluded:
#   ( ... )          the "(no gate declared for this group)" note — a parenthetical, not a command.
#                    Running it would be a shell syntax error blamed on the hook.
#   # whole-program  the emitter's own marker for unscoped gates; deferred to CI, see the header.
CMDS=$(printf '%s\n' "$OUT" | awk '
    /^gates:/         { g = 1; next }
    /^ungrouped \(/   { g = 0 }
    /^review tier:/   { g = 0 }
    g && /^    [^ (]/ {
        if ($0 ~ /# whole-program/) { next }
        sub(/[ \t]*#.*$/, "")
        sub(/^[ \t]+/, "")
        if (length($0)) print
    }
')
# `grep -c` always prints a count and exits 1 when that count is zero, so a `|| echo 0` fallback
# would append a second line and make the variable non-numeric. Let the exit status go unused.
DEFERRED=$(printf '%s\n' "$OUT" | grep -c '# whole-program')
[ -n "$DEFERRED" ] || DEFERRED=0
STAGED_N=$(printf '%s\n' "$STAGED" | wc -l | tr -d ' ')

# Group headers are `  [name] N file(s)` (2-space indent) inside the same window CMDS reads.
# Collected so the no-commands report below can tell DECLARED coverage from a coverage HOLE —
# one message for both conflated them (issue #45): files that matched groups declaring
# `gates: []` were reported in the same words as files no group claims, and the harness's own
# principle is that coverage is declared, never inferred from silence. The scaffold-claimed
# section's 2-space file lines cannot match: its paths are closed-set constants, none starting
# with `[`, and its column-0 header closes the window first anyway.
MATCHED_GROUPS=$(printf '%s\n' "$OUT" | awk '
    /^gates:/              { g = 1; next }
    /^scaffold-claimed \(/ { g = 0 }
    /^ungrouped \(/        { g = 0 }
    /^review tier:/        { g = 0 }
    # The declared-artifact drift-check header (ADR 0068) shares the 2-space "[label]" shape but
    # is NOT a group that matched staged files — splicing it in garbled this report (its trailer
    # is not "] N file(s)", so the strip below would keep the raw tail; review 2026-08-31, high).
    g && /^  \[artifacts\] [0-9]+ declared drift check/ { next }
    g && /^  \[/ {
        line = $0
        # Strip the fixed trailer, not everything after the FIRST "]" — a group name may itself
        # carry "]" and truncating it misnames the group in the report (review 2026-08-12, nit).
        sub(/^  \[/, "", line); sub(/\] [0-9]+ file\(s\)$/, "", line)
        out = out (out == "" ? "" : ", ") line
    }
    END { print out }
')

# ADR 0062 (issue #55). Files no group claims are reported by the emitter but blocked ONLY in CI
# ("Fail on ungrouped files"), so a local run read as passing right up to the first CI run. Said
# here, at the earliest local point, and never blocking: a mid-slice commit legitimately adds a
# file before the declaration catches up, and the emitter's exit contract stays advisory (ADR 0041).
UNGROUPED_N=$(printf '%s\n' "$OUT" | sed -n 's/^ungrouped (\([0-9][0-9]*\) file.*/\1/p' | head -n 1)
if [ -n "$UNGROUPED_N" ]; then
    echo "[harness] pre-commit: $UNGROUPED_N staged file(s) matched NO declared group — CI's harness-gates run FAILS on ungrouped files (not blocked here; add a groups entry to .harness.json)."
fi

if [ -z "$CMDS" ]; then
    if [ -n "$MATCHED_GROUPS" ]; then
        echo "[harness] pre-commit: the $STAGED_N staged file(s) matched group(s) [$MATCHED_GROUPS], but none yields a runnable file-scoped gate here."
    else
        echo "[harness] pre-commit: no file-scoped gate matched the $STAGED_N staged file(s)."
    fi
    if [ "$DEFERRED" -gt 0 ]; then
        echo "[harness]   $DEFERRED whole-program gate(s) deferred to CI (reported, not silent)."
    fi
    exit 0
fi

echo "[harness] pre-commit gates on $STAGED_N staged file(s):"

# Newline-delimited iteration. `set -f` disables globbing for the loop: a gate command carrying a
# `*` would otherwise be expanded against the hook's working directory before it ever runs.
FAILED=0
OLD_IFS=$IFS
set -f
IFS='
'
for c in $CMDS; do
    [ -n "$c" ] || continue
    echo "[harness]   \$ $c"
    ( cd "$ROOT" && sh -c "$c" )
    rc=$?
    if [ $rc -ne 0 ]; then
        echo "[harness]   FAIL ($rc): $c"
        FAILED=1
    fi
done
IFS=$OLD_IFS
set +f

if [ "$DEFERRED" -gt 0 ]; then
    echo "[harness]   $DEFERRED whole-program gate(s) NOT run here — deferred to CI (reported, not silent)."
fi

if [ $FAILED -ne 0 ]; then
    echo "[harness] pre-commit: deterministic gates FAILED. Fix them, or commit with --no-verify if"
    echo "[harness]   you have a reason CI will accept."
    exit 1
fi

echo "[harness] pre-commit: deterministic gates passed."
exit 0
